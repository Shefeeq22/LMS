  "course": 1
}

#api call for add lesson to module
###
POST http://127.0.0.1:8000/modules/4/lessons/
Content-Type: application/json
Authorization: Token daafaccf3b42b73c0b201510192d12ed2c5da9ad

{
  "title": "Exploratory Data Analysis (EDA)",
